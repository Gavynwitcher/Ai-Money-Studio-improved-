DATABASE_URL="postgresql://copilot:copilot@localhost:5432/unified_banking_hub?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-32-byte-random-secret"
REQUIRE_SIGNIN="false"
BOOTSTRAP_USER_EMAIL="demo@unifiedbankinghub.dev"
BOOTSTRAP_USER_PASSWORD="localdev123!"

# Plaid configuration
# Use `sandbox` for local development, `development` for internal staging, and `production` only with approved credentials.
PLAID_ENV="sandbox"
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_PRODUCTS="auth,transactions,transfer"
PLAID_REDIRECT_URI=""
PLAID_WEBHOOK_URL=""
USE_PLAID_MOCKS="true"

# Future billing / analytics / operations placeholders
NEXT_PUBLIC_APP_URL="http://localhost:3000"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2"

# Transactional email / contact notifications
CONTACT_OWNER_ALERT_TO="sales@hibark.com"
CONTACT_FROM_NAME="Northline"
BREVO_API_KEY=""
BREVO_FROM_EMAIL=""
BREVO_FROM_NAME="Northline"

# Optional fallback provider
