<section class="announcement-bar">
  <div class="page-width">
    <div class="announcement-bar__list">
      {% for block in section.blocks %}
        {% if block.settings.text != blank %}
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</a>
          {% else %}
            <p {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 3,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Share a shipping message, offer, or campaign note."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
