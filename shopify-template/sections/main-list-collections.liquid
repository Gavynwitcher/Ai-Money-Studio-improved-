<section class="section-shell">
  <div class="page-width stack">
    <div class="card stack">
      <h1>{{ section.settings.heading | escape }}</h1>
    </div>

    {% paginate collections by 12 %}
      <div class="collection-list">
        {% for collection in collections %}
          {% render 'collection-card', card_collection: collection %}
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="pagination" aria-label="Collection pagination">
          {{ paginate | default_pagination }}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Main collection list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    }
  ]
}
{% endschema %}
