<section class="section-shell">
  <div class="page-width stack">
    <div class="card stack">
      <h1>{{ blog.title }}</h1>
    </div>

    {% paginate blog.articles by 6 %}
      <div class="blog-articles">
        {% for article in blog.articles %}
          <article class="article-preview card">
            {% if article.image %}
              {{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.image.alt }}
            {% endif %}
            <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
            <div class="rte">{{ article.excerpt_or_content }}</div>
          </article>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="pagination" aria-label="Pagination">
          {{ paginate | default_pagination }}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{
  "name": "Main blog",
  "settings": []
}
{% endschema %}
