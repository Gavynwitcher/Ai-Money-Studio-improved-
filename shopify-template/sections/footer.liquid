<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__top">
      <div class="stack">
        <strong>{{ shop.name }}</strong>
        <p class="meta">Finish this scaffold with a clear demo-store voice, assets, and a unique visual system.</p>
      </div>

      <nav aria-label="Footer">
        <ul class="footer-menu">
          {% for link in linklists[section.settings.menu].links %}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {% endfor %}
        </ul>
      </nav>

      <ul class="social-links">
        {% if settings.social_instagram != blank %}<li><a href="{{ settings.social_instagram }}" rel="nofollow">Instagram</a></li>{% endif %}
        {% if settings.social_facebook != blank %}<li><a href="{{ settings.social_facebook }}" rel="nofollow">Facebook</a></li>{% endif %}
        {% if settings.social_tiktok != blank %}<li><a href="{{ settings.social_tiktok }}" rel="nofollow">TikTok</a></li>{% endif %}
        {% if settings.social_youtube != blank %}<li><a href="{{ settings.social_youtube }}" rel="nofollow">YouTube</a></li>{% endif %}
        {% if settings.social_pinterest != blank %}<li><a href="{{ settings.social_pinterest }}" rel="nofollow">Pinterest</a></li>{% endif %}
      </ul>
    </div>

    <div class="site-footer__bottom">
      {% if section.settings.show_localization %}
        {% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
          {% form 'localization', id: 'FooterLocalizationForm' %}
            {% if localization.available_countries.size > 1 %}
              <label for="FooterCountry">Country</label>
              <select id="FooterCountry" name="country_code">
                {% for country in localization.available_countries %}
                  <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                    {{ country.name }} ({{ country.currency.iso_code }})
                  </option>
                {% endfor %}
              </select>
            {% endif %}

            {% if localization.available_languages.size > 1 %}
              <label for="FooterLanguage">Language</label>
              <select id="FooterLanguage" name="locale_code">
                {% for language in localization.available_languages %}
                  <option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                    {{ language.endonym_name }}
                  </option>
                {% endfor %}
              </select>
            {% endif %}

            <button type="submit">Update</button>
          {% endform %}
        {% endif %}
      {% endif %}

      {% if section.settings.show_payment_icons and shop.enabled_payment_types != empty %}
        <ul class="social-links" aria-label="Accepted payment methods">
          {% for type in shop.enabled_payment_types %}
            <li>{{ type | payment_type_svg_tag }}</li>
          {% endfor %}
        </ul>
      {% endif %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Show localization selectors",
      "default": true
    }
  ]
}
{% endschema %}
