<section class="section-shell">
  <div class="page-width password-layout">
    <div class="card stack password-shell">
      {% if settings.logo != blank %}
        {{ settings.logo | image_url: width: settings.logo_width | image_tag: alt: shop.name }}
      {% else %}
        <h1>{{ shop.name }}</h1>
      {% endif %}

      {% if shop.password_message != blank %}
        <p>{{ shop.password_message }}</p>
      {% endif %}

      {% form 'storefront_password', class: 'stack' %}
        {{ form.errors | default_errors }}
        <label for="Password-{{ section.id }}">Password</label>
        <input id="Password-{{ section.id }}" type="password" name="password" required>
        <button type="submit">Enter store</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main password",
  "settings": []
}
{% endschema %}
