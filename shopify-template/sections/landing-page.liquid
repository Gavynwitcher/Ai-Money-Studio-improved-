{% liquid
  assign stat_blocks = section.blocks | where: 'type', 'stat'
  assign feature_blocks = section.blocks | where: 'type', 'feature'
%}

<section
  class="landing-page-section"
  style="
    --landing-bg: {{ section.settings.background }};
    --landing-surface: {{ section.settings.surface }};
    --landing-text: {{ section.settings.text_color }};
    --landing-accent: {{ section.settings.accent }};
  "
>
  <div class="landing-page__inner page-width">
    <div class="landing-page__hero">
      <div class="landing-page__copy">
        {% if section.settings.eyebrow != blank %}
          <p class="landing-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h1 class="landing-page__heading">{{ section.settings.heading | escape }}</h1>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <div class="landing-page__subheading rte">
            <p>{{ section.settings.subheading | escape }}</p>
          </div>
        {% endif %}

        <div class="landing-page__actions">
          {% if section.settings.primary_button_label != blank and section.settings.primary_button_link != blank %}
            <a class="landing-page__button landing-page__button--primary" href="{{ section.settings.primary_button_link }}">
              {{ section.settings.primary_button_label | escape }}
            </a>
          {% endif %}

          {% if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank %}
            <a class="landing-page__button landing-page__button--secondary" href="{{ section.settings.secondary_button_link }}">
              {{ section.settings.secondary_button_label | escape }}
            </a>
          {% endif %}
        </div>

        {% if stat_blocks.size > 0 %}
          <div class="landing-page__stats" role="list">
            {% for block in stat_blocks %}
              <div class="landing-page__stat" role="listitem" {{ block.shopify_attributes }}>
                {% if block.settings.value != blank %}
                  <strong class="landing-page__stat-value">{{ block.settings.value | escape }}</strong>
                {% endif %}
                {% if block.settings.label != blank %}
                  <span class="landing-page__stat-label">{{ block.settings.label | escape }}</span>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <aside class="landing-page__panel">
        {% if section.settings.panel_heading != blank %}
          <h2>{{ section.settings.panel_heading | escape }}</h2>
        {% endif %}
        {% if section.settings.panel_body != blank %}
          <p>{{ section.settings.panel_body | escape }}</p>
        {% endif %}
      </aside>
    </div>

    {% if feature_blocks.size > 0 %}
      <div class="landing-page__features">
        {% for block in feature_blocks %}
          <article class="landing-page__feature" {{ block.shopify_attributes }}>
            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title | escape }}</h3>
            {% endif %}
            {% if block.settings.body != blank %}
              <p>{{ block.settings.body | escape }}</p>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}

    <div class="landing-page__cta">
      {% if section.settings.cta_heading != blank %}
        <h2>{{ section.settings.cta_heading | escape }}</h2>
      {% endif %}
      {% if section.settings.cta_body != blank %}
        <p>{{ section.settings.cta_body | escape }}</p>
      {% endif %}
      {% if section.settings.cta_button_label != blank and section.settings.cta_button_link != blank %}
        <a class="landing-page__button landing-page__button--primary" href="{{ section.settings.cta_button_link }}">
          {{ section.settings.cta_button_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .landing-page-section {
    background: var(--landing-bg);
    color: var(--landing-text);
    padding: 48px 0 72px;
  }

  .landing-page__inner {
    display: grid;
    gap: 32px;
  }

  .landing-page__hero {
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
    align-items: start;
  }

  .landing-page__copy,
  .landing-page__panel,
  .landing-page__feature,
  .landing-page__cta {
    background: var(--landing-surface);
    border-radius: 24px;
    padding: 28px;
    box-shadow: 0 20px 50px rgba(31, 26, 23, 0.08);
  }

  .landing-page__eyebrow {
    display: inline-flex;
    margin: 0 0 12px;
    padding: 6px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--landing-accent) 12%, white);
    color: var(--landing-accent);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .landing-page__heading {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.75rem);
    line-height: 0.95;
  }

  .landing-page__subheading p,
  .landing-page__panel p,
  .landing-page__feature p,
  .landing-page__cta p {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: rgba(31, 26, 23, 0.78);
  }

  .landing-page__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .landing-page__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
  }

  .landing-page__button--primary {
    background: var(--landing-accent);
    color: #fff;
  }

  .landing-page__button--secondary {
    border: 1px solid rgba(31, 26, 23, 0.14);
    color: var(--landing-text);
  }

  .landing-page__stats {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    margin-top: 28px;
  }

  .landing-page__stat {
    padding: 18px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(31, 26, 23, 0.08);
  }

  .landing-page__stat-value {
    display: block;
    font-size: 1.6rem;
    line-height: 1.1;
  }

  .landing-page__stat-label {
    display: block;
    margin-top: 6px;
    color: rgba(31, 26, 23, 0.72);
  }

  .landing-page__panel h2,
  .landing-page__cta h2 {
    margin: 0 0 12px;
    font-size: 1.5rem;
  }

  .landing-page__features {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .landing-page__feature h3 {
    margin: 0 0 10px;
    font-size: 1.2rem;
  }

  .landing-page__cta {
    text-align: center;
  }

  .landing-page__cta .landing-page__button {
    margin-top: 20px;
  }

  @media screen and (max-width: 989px) {
    .landing-page__hero,
    .landing-page__features {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 749px) {
    .landing-page-section {
      padding: 24px 0 48px;
    }

    .landing-page__copy,
    .landing-page__panel,
    .landing-page__feature,
    .landing-page__cta {
      padding: 22px;
      border-radius: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Landing page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New release"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build a landing page that converts without touching code"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Use this Shopify template as a starting point for campaigns, product launches, or seasonal promotions."
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "text",
      "id": "panel_heading",
      "label": "Side panel heading",
      "default": "Why this template works"
    },
    {
      "type": "textarea",
      "id": "panel_body",
      "label": "Side panel body",
      "default": "It gives you a clean hero, social proof, feature cards, and a final call to action in one editable section."
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "CTA heading",
      "default": "Ready to launch your next campaign?"
    },
    {
      "type": "textarea",
      "id": "cta_body",
      "label": "CTA body",
      "default": "Swap the text, connect the buttons, and publish."
    },
    {
      "type": "text",
      "id": "cta_button_label",
      "label": "CTA button label",
      "default": "Start customizing"
    },
    {
      "type": "url",
      "id": "cta_button_link",
      "label": "CTA button link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background color",
      "default": "#f4efe7"
    },
    {
      "type": "color",
      "id": "surface",
      "label": "Card color",
      "default": "#fffdf8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1f1a17"
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent color",
      "default": "#b35c2e"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "4.8/5"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Average customer rating"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Flexible hero copy"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Update headings, description text, and button links directly in the theme editor."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Landing page"
    }
  ]
}
{% endschema %}
