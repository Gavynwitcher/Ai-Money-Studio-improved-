<section class="section-shell">
  <div class="page-width hero-layout">
    <div class="card stack">
      {% if section.settings.eyebrow != blank %}
        <p class="badge">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h1>{{ section.settings.heading | escape }}</h1>
      <p class="meta">{{ section.settings.body | escape }}</p>
      <div class="stack">
        {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}
          <a class="button button--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }}</a>
        {% endif %}
        {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}
          <a class="button button--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>
        {% endif %}
      </div>
    </div>

    <div class="card stack">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1200 | image_tag: alt: section.settings.heading }}
      {% endif %}
      <p class="meta">Replace this content with original brand storytelling and benchmark imagery for your demo store.</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main index hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Theme Store scaffold"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build an original Shopify theme with a stronger point of view"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Use this homepage hero as a placeholder while you develop a distinct visual language, merchandising structure, and merchant story."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop featured"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Read the story"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
  ],
  "presets": [
    {
      "name": "Main index hero"
    }
  ]
}
{% endschema %}
