generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String                            @id @default(cuid())
  email                       String                            @unique
  name                        String?
  passwordHash                String
  stripeCustomerId            String?                           @unique
  emailVerifiedAt             DateTime?
  termsAcceptedAt             DateTime?
  termsAcceptedIp             String?
  termsAcceptedVersion        String?
  stripeConnectedAccounts     StripeConnectedAccount[]
  billingPlan                 String                            @default("starter")
  billingStatus               String                            @default("inactive")
  createdAt                   DateTime                          @default(now())
  updatedAt                   DateTime                          @updatedAt
  ruleSettings                RuleSettings?
  billingSubscriptions        BillingSubscription[]
  billingEvents               BillingEvent[]
  strategies                  StrategyTemplate[]
  backtestRuns                BacktestRun[]
  candidateTrades             CandidateTrade[]
  paperPositions              PaperPosition[]
  tradeLogs                   TradeLog[]
  moneyCopilotAccounts        MoneyCopilotAccount[]
  moneyCopilotProfile         MoneyCopilotProfile?
  moneyCopilotTransactions    MoneyCopilotTransaction[]
  moneyCopilotGoals           MoneyCopilotGoal[]
  moneyCopilotDebts           MoneyCopilotDebt[]
  moneyCopilotRecommendations MoneyCopilotRecommendation[]
  moneyCopilotActions         MoneyCopilotAction[]
  moneyCopilotRecurringSeries MoneyCopilotRecurringSeries[]
  moneyCopilotSafeToSpend     MoneyCopilotSafeToSpendSnapshot[]
  plaidItems                  PlaidItem[]
  creditConsents              CreditConsent[]
  creditProfiles              CreditProfile[]
  creditReportSnapshots       CreditReportSnapshot[]
  creditAlerts                CreditAlert[]
  accountingAccounts          AccountingAccount[]
  accountingJournalEntries    AccountingJournalEntry[]
  accountingInvoices          AccountingInvoice[]
  accountingBills             AccountingBill[]
  accountingReconciliations   AccountingReconciliationItem[]
  squareConnections           SquareConnection[]
  squareLocations             SquareLocation[]
  squareBankAccounts          SquareBankAccount[]
  squarePayments              SquarePayment[]
  squareRefunds               SquareRefund[]
  squarePayouts               SquarePayout[]
  squareTransferRequests      SquareTransferRequest[]
}

model ContactInquiry {
  id              String                @id @default(cuid())
  name            String
  email           String
  emailNormalized String
  company         String?
  message         String
  status          String                @default("received")
  source          String                @default("contact_form")
  ownerAlertEmail String                @default("sales@hibark.com")
  ownerAlertStatus String               @default("queued")
  ownerAlertSentAt DateTime?
  ownerAlertError String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  notifications   ContactNotification[]

  @@index([emailNormalized, createdAt])
  @@index([status, createdAt])
}

model BillingSubscription {
  id                  String   @id @default(cuid())
  userId              String
  provider            String   @default("stripe")
  stripeCustomerId    String
  stripeSubscriptionId String  @unique
  stripePriceId       String?
  planKey             String
  status              String
  cancelAtPeriodEnd   Boolean  @default(false)
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  trialEnd            DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, updatedAt])
  @@index([stripeCustomerId, updatedAt])
}

model BillingEvent {
  id              String   @id @default(cuid())
  userId          String?
  provider        String   @default("stripe")
  providerEventId String   @unique
  eventType       String
  payloadJson     String
  processedAt     DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, processedAt])
  @@index([eventType, processedAt])
}

model StripeConnectedAccount {
  id                          String   @id @default(cuid())
  userId                      String
  stripeAccountId             String   @unique
  email                       String?
  country                     String?  @default("US")
  accountType                 String   @default("express")
  onboardingStatus            String   @default("created")
  detailsSubmitted            Boolean  @default(false)
  chargesEnabled              Boolean  @default(false)
  payoutsEnabled              Boolean  @default(false)
  cardPaymentsRequested       Boolean  @default(true)
  transfersRequested          Boolean  @default(true)
  treasuryRequested           Boolean  @default(false)
  currentlyDueCount           Int      @default(0)
  eventuallyDueCount          Int      @default(0)
  pendingVerificationCount    Int      @default(0)
  disabledReason              String?
  lastAccountLinkCreatedAt    DateTime?
  lastSyncedAt                DateTime?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([onboardingStatus, updatedAt])
}

model ContactNotification {
  id             String         @id @default(cuid())
  inquiryId      String
  channel        String         @default("in_app")
  title          String
  message        String
  sentAt         DateTime       @default(now())
  acknowledgedAt DateTime?

  inquiry ContactInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, sentAt])
}

model CreditConsent {
  id                 String   @id @default(cuid())
  userId             String
  provider           String
  monitoringEnabled  Boolean  @default(false)
  reportsEnabled     Boolean  @default(false)
  scoreAccessEnabled Boolean  @default(false)
  permissiblePurpose String   @default("consumer_direct_access")
  consentVersion     String   @default("v1")
  consentIp          String?
  consentedAt        DateTime @default(now())
  revokedAt          DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider, monitoringEnabled])
}

model CreditProfile {
  id                    String   @id @default(cuid())
  userId                String
  provider              String
  bureauScope           String   @default("single_bureau")
  monitoringStatus      String   @default("inactive")
  scoreModel            String?
  scoreValue            Int?
  scoreBand             String?
  scoreDelta            Int      @default(0)
  utilizationPct        Float?
  totalOpenAccounts     Int?
  averageAccountAgeMo   Int?
  hardInquiries         Int?
  derogatoryAccounts    Int?
  alertsLast30Days      Int      @default(0)
  reportRefreshedAt     DateTime?
  nextRefreshAt         DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([monitoringStatus, updatedAt])
}

model CreditReportSnapshot {
  id                    String   @id @default(cuid())
  userId                String
  provider              String
  reportType            String   @default("summary")
  bureau                String   @default("equifax")
  reportDate            DateTime @default(now())
  scoreValue            Int?
  scoreModel            String?
  summaryJson           String
  factorsJson           String
  disputesUrl           String?
  providerReferenceId   String?
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reportDate])
  @@index([provider, bureau, reportDate])
}

model CreditAlert {
  id                  String   @id @default(cuid())
  userId              String
  provider            String
  bureau              String   @default("equifax")
  alertType           String
  severity            String   @default("info")
  title               String
  description         String
  occurredAt          DateTime
  acknowledgedAt      DateTime?
  metadataJson        String?
  providerReferenceId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([severity, occurredAt])
}

model AccountingAccount {
  id             String   @id @default(cuid())
  userId         String
  code           String
  name           String
  category       String
  subtype        String
  balance        Float
  direction      String   @default("debit")
  status         String   @default("active")
  institutionRef String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId, category])
}

model AccountingJournalEntry {
  id               String   @id @default(cuid())
  userId           String
  entryDate        DateTime
  reference        String
  memo             String
  debitAccountCode String
  creditAccountCode String
  amount           Float
  source           String   @default("manual")
  status           String   @default("posted")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, entryDate])
  @@index([userId, status])
}

model AccountingInvoice {
  id            String   @id @default(cuid())
  userId        String
  invoiceNumber String
  customerName  String
  issueDate     DateTime
  dueDate       DateTime
  amount        Float
  amountPaid    Float    @default(0)
  status        String   @default("open")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, invoiceNumber])
  @@index([userId, status, dueDate])
}

model AccountingBill {
  id          String   @id @default(cuid())
  userId      String
  vendorName  String
  billNumber  String
  issueDate   DateTime
  dueDate     DateTime
  amount      Float
  amountPaid  Float    @default(0)
  status      String   @default("open")
  expenseCode String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, billNumber])
  @@index([userId, status, dueDate])
}

model AccountingReconciliationItem {
  id                 String   @id @default(cuid())
  userId             String
  source             String
  statementDate      DateTime
  description        String
  amount             Float
  status             String   @default("needs_review")
  suggestedAccountCode String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, statementDate])
}

model MoneyCopilotProfile {
  id       String   @id @default(cuid())
  userId   String   @unique
  seededAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model RuleSettings {
  id                       String   @id @default(cuid())
  userId                   String   @unique
  maxRiskPerTradePct       Float
  maxOpenPositions         Int
  maxDailyLossPct          Float
  maxTradesPerDay          Int
  cooldownMinutes          Int
  tickerConcentrationPct   Float
  strategyConcentrationPct Float
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model StrategyTemplate {
  id                String   @id @default(cuid())
  userId            String
  name              String
  description       String?
  strategyType      String
  trendFilters      String
  volatilityFilters String
  dteTarget         Int
  spreadWidth       Float
  profitTargetPct   Float
  stopLossPct       Float
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user            User             @relation(fields: [userId], references: [id])
  backtestRuns    BacktestRun[]
  candidateTrades CandidateTrade[]
}

model BacktestRun {
  id                 String   @id @default(cuid())
  userId             String
  strategyTemplateId String
  symbol             String
  startDate          DateTime
  endDate            DateTime
  equityCurve        String
  maxDrawdown        Float
  winRate            Float
  lossStreaks        String
  violationPressure  String
  createdAt          DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id])
  strategy StrategyTemplate @relation(fields: [strategyTemplateId], references: [id])
}

model CandidateTrade {
  id                 String   @id @default(cuid())
  userId             String
  strategyTemplateId String?
  symbol             String
  strategyType       String
  riskDollars        Float
  riskPct            Float
  complianceStatus   String
  complianceScore    Int
  violationReasons   String
  warningReasons     String
  notes              String?
  createdAt          DateTime @default(now())

  user      User              @relation(fields: [userId], references: [id])
  strategy  StrategyTemplate? @relation(fields: [strategyTemplateId], references: [id])
  tradeLogs TradeLog[]
}

model PaperPosition {
  id               String    @id @default(cuid())
  userId           String
  symbol           String
  strategyType     String
  openedAt         DateTime
  closedAt         DateTime?
  riskDollars      Float
  riskPct          Float
  complianceStatus String
  complianceScore  Int
  violationReasons String
  warningReasons   String
  outcome          String
  metadata         String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  tradeLogs TradeLog[]
}

model TradeLog {
  id               String   @id @default(cuid())
  userId           String
  candidateTradeId String?
  paperPositionId  String?
  symbol           String
  strategyType     String
  riskDollars      Float
  riskPct          Float
  complianceStatus String
  complianceScore  Int
  violationReasons String
  warningReasons   String
  action           String
  createdAt        DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id])
  candidateTrade CandidateTrade? @relation(fields: [candidateTradeId], references: [id])
  paperPosition  PaperPosition?  @relation(fields: [paperPositionId], references: [id])
}

model MoneyCopilotAccount {
  id                String   @id @default(cuid())
  userId            String
  providerAccountId String?  @unique
  name              String
  type              String
  currency          String   @default("USD")
  currentBalance    Float
  availableBalance  Float?
  accountMask       String?
  routingNumberSuffix String?
  bankVerificationStatus String?
  verificationName  String?
  persistentAccountId String?
  holderCategory    String?
  isTokenizedAccountNumber Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user         User                      @relation(fields: [userId], references: [id])
  transactions MoneyCopilotTransaction[]

  @@index([userId, type])
  @@index([userId, bankVerificationStatus])
}

model MoneyCopilotTransaction {
  id                    String   @id @default(cuid())
  userId                String
  accountId             String?
  providerTransactionId String?  @unique
  postedAt              DateTime
  amount                Float
  currency              String   @default("USD")
  merchantRaw           String
  merchantNormalized    String
  category              String
  confidence            Float
  recurring             Boolean  @default(false)
  createdAt             DateTime @default(now())

  user    User                 @relation(fields: [userId], references: [id])
  account MoneyCopilotAccount? @relation(fields: [accountId], references: [id])

  @@index([userId, postedAt])
}

model PlaidItem {
  id              String    @id @default(cuid())
  userId          String
  plaidItemId     String
  accessToken     String
  institutionName String?
  authMethod      String?
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, plaidItemId])
  @@index([userId, updatedAt])
}

model SquareConnection {
  id           String    @id @default(cuid())
  userId       String
  merchantId   String
  merchantName String?
  accessToken  String
  refreshToken String?
  tokenType    String?
  scopes       String?
  environment  String    @default("sandbox")
  status       String    @default("connected")
  expiresAt    DateTime?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user             User                    @relation(fields: [userId], references: [id])
  locations        SquareLocation[]
  bankAccounts     SquareBankAccount[]
  payments         SquarePayment[]
  refunds          SquareRefund[]
  payouts          SquarePayout[]
  transferRequests SquareTransferRequest[]

  @@unique([userId, merchantId])
  @@index([userId, status, updatedAt])
}

model SquareLocation {
  id                 String   @id @default(cuid())
  userId             String
  squareConnectionId String
  squareLocationId   String
  name               String
  status             String?
  currency           String   @default("USD")
  timezone           String?
  country            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id])
  connection SquareConnection @relation(fields: [squareConnectionId], references: [id])

  @@unique([squareConnectionId, squareLocationId])
  @@index([userId, updatedAt])
}

model SquareBankAccount {
  id                  String   @id @default(cuid())
  userId              String
  squareConnectionId  String
  squareBankAccountId String
  bankName            String?
  accountType         String?
  routingSuffix       String?
  accountSuffix       String?
  status              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id])
  connection SquareConnection @relation(fields: [squareConnectionId], references: [id])
  payouts    SquarePayout[]

  @@unique([squareConnectionId, squareBankAccountId])
  @@index([userId, updatedAt])
}

model SquarePayment {
  id                 String    @id @default(cuid())
  userId             String
  squareConnectionId String
  squarePaymentId    String
  squareLocationId   String?
  orderId            String?
  customerId         String?
  status             String
  sourceType         String?
  amount             Float
  tipAmount          Float     @default(0)
  processingFee      Float     @default(0)
  netAmount          Float
  currency           String    @default("USD")
  approvedAt         DateTime?
  createdAtSquare    DateTime
  updatedAtSquare    DateTime?
  syncedAt           DateTime  @default(now())

  user       User             @relation(fields: [userId], references: [id])
  connection SquareConnection @relation(fields: [squareConnectionId], references: [id])
  refunds    SquareRefund[]

  @@unique([squareConnectionId, squarePaymentId])
  @@index([userId, approvedAt])
  @@index([squareConnectionId, createdAtSquare])
}

model SquareRefund {
  id                 String    @id @default(cuid())
  userId             String
  squareConnectionId String
  squarePaymentId    String?
  squareRefundId     String
  status             String
  reason             String?
  amount             Float
  currency           String    @default("USD")
  createdAtSquare    DateTime
  updatedAtSquare    DateTime?
  syncedAt           DateTime  @default(now())

  user       User             @relation(fields: [userId], references: [id])
  connection SquareConnection @relation(fields: [squareConnectionId], references: [id])
  payment    SquarePayment?   @relation(fields: [squarePaymentId], references: [id])

  @@unique([squareConnectionId, squareRefundId])
  @@index([userId, createdAtSquare])
}

model SquarePayout {
  id                  String    @id @default(cuid())
  userId              String
  squareConnectionId  String
  squarePayoutId      String
  squareBankAccountId String?
  squareLocationId    String?
  status              String
  payoutType          String?
  amount              Float
  feeAmount           Float     @default(0)
  currency            String    @default("USD")
  arrivalDate         DateTime?
  paidOutAt           DateTime?
  createdAtSquare     DateTime
  updatedAtSquare     DateTime?
  syncedAt            DateTime  @default(now())

  user        User               @relation(fields: [userId], references: [id])
  connection  SquareConnection   @relation(fields: [squareConnectionId], references: [id])
  bankAccount SquareBankAccount? @relation(fields: [squareBankAccountId], references: [id])

  @@unique([squareConnectionId, squarePayoutId])
  @@index([userId, arrivalDate])
  @@index([squareConnectionId, createdAtSquare])
}

model SquareTransferRequest {
  id                 String    @id @default(cuid())
  userId             String
  squareConnectionId String?
  fromSource         String
  toSource           String
  amount             Float
  currency           String    @default("USD")
  purpose            String
  status             String    @default("pending")
  executionRail      String    @default("manual")
  squareReferenceId  String?
  scheduledFor       DateTime?
  executedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user       User              @relation(fields: [userId], references: [id])
  connection SquareConnection? @relation(fields: [squareConnectionId], references: [id])

  @@index([userId, status, createdAt])
}

model MoneyCopilotGoal {
  id                  String   @id @default(cuid())
  userId              String
  title               String
  targetAmount        Float
  currentAmount       Float
  targetDate          DateTime
  monthlyContribution Float
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, targetDate])
}

model MoneyCopilotDebt {
  id             String   @id @default(cuid())
  userId         String
  issuer         String
  balance        Float
  apr            Float
  minimumPayment Float
  dueDate        DateTime
  creditLimit    Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, dueDate])
}

model MoneyCopilotRecurringSeries {
  id               String   @id @default(cuid())
  userId           String
  serviceName      String
  cadence          String
  nextExpectedDate DateTime
  expectedAmount   Float
  type             String
  autopay          Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type, nextExpectedDate])
}

model MoneyCopilotSafeToSpendSnapshot {
  id              String   @id @default(cuid())
  userId          String
  timestamp       DateTime @default(now())
  horizon         String
  amount          Float
  confidence      Float
  assumptionsJson String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, horizon, timestamp])
}

model MoneyCopilotRecommendation {
  id                 String   @id @default(cuid())
  userId             String
  title              String
  recommendationType String
  rationale          String
  estimatedImpact    Float
  confidence         Float
  status             String   @default("PROPOSED")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status, createdAt])
}

model MoneyCopilotAction {
  id              String   @id @default(cuid())
  userId          String
  actionType      String
  status          String   @default("PROPOSED")
  expectedOutcome String
  downside        String
  requiresStepUp  Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status, createdAt])
}
